  "scenarios": [
    {
      "name": "OSPF Full Convergence",
      "description": "Все роутеры обмениваются LSA, строят SPT",
      "actions": [{"type": "link.set", "a": "r-core1", "b": "r-core2", "up": false}, {"type": "wait", "ticks": 120}, {"type": "link.set", "a": "r-core1", "b": "r-core2", "up": true}]
    },
    {
      "name": "ACL Block WiFi to DMZ",
      "description": "W1 пытается достучаться до DB — FW блокирует по ACL",
      "actions": [{"type": "ping", "src": "w1", "dst": "db"}]
    },
    {
      "name": "DNS + HTTP via NAT",
      "description": "A1 резолвит web.local, затем открывает HTTPS через NAT",
      "actions": [{"type": "dns_query", "src": "a1", "name": "web.local", "server": "dns"}, {"type": "http_get", "src": "a1", "dst": "web", "port": 443}]
    }
  ]
