{
  "name": "Classroom LAN",
  "level": 1,
  "description": "Базовая топология для MVP: ARP, ICMP, VLAN 802.1Q, DHCP",
  "devices": [
    {"id": "pc1", "kind": "host", "label": "PC1", "x": 120, "y": 100, "ips": ["10.0.10.11/24"], "vlan": 10},
    {"id": "pc2", "kind": "host", "label": "PC2", "x": 280, "y": 100, "ips": ["10.0.10.12/24"], "vlan": 10},
    {"id": "pc3", "kind": "host", "label": "PC3", "x": 440, "y": 100, "ips": ["10.0.10.13/24"], "vlan": 10},
    {"id": "pc4", "kind": "host", "label": "PC4", "x": 600, "y": 100, "ips": ["10.0.10.14/24"], "vlan": 10},
    {"id": "tch1", "kind": "host", "label": "TCH1", "x": 200, "y": 220, "ips": ["10.0.20.21/24"], "vlan": 20},
    {"id": "tch2", "kind": "host", "label": "TCH2", "x": 520, "y": 220, "ips": ["10.0.20.22/24"], "vlan": 20},
    {"id": "sw1", "kind": "switch", "label": "SW1", "x": 360, "y": 350, "ips": [], "vlan": null, "vlans": [10, 20], "trunk_ports": ["eth0"]},
    {"id": "r1", "kind": "router", "label": "R1", "x": 360, "y": 520, "ips": ["10.0.10.1/24", "10.0.20.1/24"], "vlan": null, "routes": [{"dest": "10.0.10.0/24", "via": "direct", "iface": "eth0"}, {"dest": "10.0.20.0/24", "via": "direct", "iface": "eth1"}], "dhcp_pools": [{"vlan": 10, "range": ["10.0.10.100", "10.0.10.200"], "gateway": "10.0.10.1", "dns": "10.0.10.1"}, {"vlan": 20, "range": ["10.0.20.100", "10.0.20.200"], "gateway": "10.0.20.1", "dns": "10.0.20.1"}]}
  ],
  "links": [
    {"a": "pc1", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "pc2", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "pc3", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "pc4", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "tch1", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "tch2", "b": "sw1", "bandwidthKbps": 100000, "up": true, "vlan_tag": null},
    {"a": "sw1", "b": "r1", "bandwidthKbps": 1000000, "up": true, "vlan_tag": "trunk"}
  ],
  "scenarios": [
    {
      "name": "ARP + ICMP same VLAN",
      "description": "PC1 отправляет ping на PC3. Оба в VLAN 10.",
      "actions": [{"type": "ping", "src": "pc1", "dst": "pc3"}],
      "expected": ["ARP Request (broadcast) от pc1", "ARP Reply от pc3", "ICMP Echo Request", "ICMP Echo Reply"]
    },
    {
      "name": "Inter-VLAN ping",
      "description": "PC1 (VLAN 10) пингует TCH1 (VLAN 20) через R1.",
      "actions": [{"type": "ping", "src": "pc1", "dst": "tch1"}],
      "expected": ["ARP Request от pc1 для MAC шлюза (R1)", "ICMP до R1, L3-форвардинг", "ARP на VLAN 20 интерфейсе R1", "ICMP до TCH1, Echo Reply обратно"]
    }
  ]
}